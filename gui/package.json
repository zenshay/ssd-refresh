{
  "name": "ssd-refresh-gui",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests test-cdp.js",
    "lint:fix": "biome check --write src tests test-cdp.js",
    "format": "biome format --write src tests test-cdp.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/register.mjs --test tests/actions.test.mjs",
    "test:mutation": "node tests/mutation.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2.1.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
