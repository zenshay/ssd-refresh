{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSD Refresh",
  "version": "0.1.0",
  "identifier": "com.ssdrefresh.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSD Refresh",
        "width": 900,
        "height": 780,
        "minWidth": 820,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  }
}
