{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSD Refresh",
  "version": "0.1.0",
  "identifier": "com.ssdrefresh.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSD Refresh",
        "width": 860,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
